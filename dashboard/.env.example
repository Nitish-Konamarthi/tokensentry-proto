# TokenSentry Dashboard
# Server-only gateway configuration. Never use NEXT_PUBLIC_ for credentials.
TOKENSENTRY_API_URL=http://localhost:3000
TOKENSENTRY_DASHBOARD_API_KEY=ts_live_your_gateway_admin_key
# Comma-separated Auth0 email addresses authorized to use this gateway key.
DASHBOARD_ALLOWED_EMAILS=admin@example.com

# Auth0 (required for authentication)
AUTH0_SECRET=32_char_hex_secret_use_openssl_rand_hex_32
AUTH0_BASE_URL=http://localhost:3001
AUTH0_ISSUER_BASE_URL=https://tokensentry.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=https://api.tokensentry.ai
