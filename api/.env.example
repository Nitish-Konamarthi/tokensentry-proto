# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── Security ────────────────────────────────────────────────────────────
# Must be at least 32 characters.
API_KEY_PEPPER=change-me-to-at-least-32-characters-long

# ── Database ────────────────────────────────────────────────────────────
# PostgreSQL is running in Docker but port 5432 is exposed to WSL.
DATABASE_URL=postgresql://tokensentry:changeme_secure_password@localhost:5432/tokensentry

# ── Valkey ─────────────────────────────────────────────────────────────
# Valkey is running in Docker but port 6379 is exposed to WSL.
VALKEY_URL=redis://localhost:6379

# ── Auth0 ──────────────────────────────────────────────────────────────
# Replace these with real Auth0 values when testing Auth0 authentication.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.tokensentry.ai

# ── AI Providers ────────────────────────────────────────────────────────
# Leave empty for now if you don't want to make real provider calls.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# OpenRouter upstream (optional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# ── Rate Limits ────────────────────────────────────────────────────────
RATE_LIMIT_PROXY_ORG=500

# ── Trusted Proxies ─────────────────────────────────────────────────────
# Local development defaults to loopback only. Configure the exact proxy IP/CIDR in deployment.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
