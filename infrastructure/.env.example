# ============================================================
# PostgreSQL
# ============================================================

PG_USER=tokensentry
PG_PASSWORD=changeme_secure_password
PG_DATABASE=tokensentry

DATABASE_URL=postgresql://tokensentry:changeme_secure_password@postgres:5432/tokensentry?sslmode=disable


# ============================================================
# TokenSentry
# ============================================================

TS_PEPPER=0123456789abcdef0123456789abcdef


# ============================================================
# Auth0
# ============================================================

AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_SECRET=change_this_to_a_random_secret_at_least_32_characters


# ============================================================
# LLM Providers
# ============================================================

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# OpenRouter upstream (optional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# ============================================================
# Dashboard
# ============================================================

TOKENSENTRY_DASHBOARD_API_KEY=ts_live_your_dashboard_api_key
DASHBOARD_ALLOWED_EMAILS=admin@example.com


# ============================================================
# Monitoring
# ============================================================

SENTRY_DSN=
