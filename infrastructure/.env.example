# ── Required ──
DATABASE_URL=postgresql://tokensentry:changeme_secure_password@postgres:5432/tokensentry?sslmode=disable
TS_PEPPER=replace_with_32_char_hex_string
# docker-compose maps this to API_KEY_PEPPER at runtime

# ── Auth0 ──
AUTH0_DOMAIN=tokensentry.us.auth0.com
AUTH0_AUDIENCE=https://api.tokensentry.ai
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_SECRET=32_char_hex_secret_for_session_encryption

# ── AI Providers (set at least one) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Stripe (optional) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUSINESS=price_business_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# ── Dashboard ──
DASHBOARD_API_KEY=ts_live_your_dashboard_api_key

# ── Monitoring ──
SENTRY_DSN=

# ── OpenTelemetry (optional — leave blank for debug-only) ──
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_INSECURE=true
OTEL_EXPORTER_OTLP_HEADERS=

# ── SSL ──
CERTBOT_EMAIL=admin@tokensentry.ai
